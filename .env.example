# Obtain a client registration directly from NuHeat/Chemelex support.
NUHEAT_CLIENT_ID=
# Required only when Chemelex registers the client as confidential.
NUHEAT_CLIENT_SECRET=
NUHEAT_REDIRECT_URI=http://127.0.0.1:8765/callback

# Persist the rotated refresh token in a secure store in production. For this
# local POC it may be supplied through the environment instead.
NUHEAT_REFRESH_TOKEN=

